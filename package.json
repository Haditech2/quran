{
  "name": "quran-memorization-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "env -u CI CI=false sh scripts/dev.sh",
    "dev:usb": "env -u CI CI=false sh scripts/dev-usb.sh",
    "dev:usb:tunnel": "env -u CI CI=false sh scripts/dev-usb-tunnel.sh",
    "stop": "sh scripts/stop-dev.sh",
    "usb:reverse": "sh scripts/usb-reverse.sh",
    "usb:check": "sh scripts/check-usb.sh",
    "dev:tunnel": "env -u CI CI=false sh scripts/dev-usb-tunnel.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "cd backend && python3 manage.py runserver 0.0.0.0:8000",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.0",
    "expo-file-system": "~19.0.22",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "^0.29.14",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~54.0.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.9.2"
  }
}
